<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>EasyTerminal</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs handles the ssh helper modes before any XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- These initializers run before Main and would crash the ssh helper modes; Program.cs bootstraps instead. -->
    <WindowsAppSdkIncludeVersionInfo>true</WindowsAppSdkIncludeVersionInfo>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
  </PropertyGroup>

  <!-- Installer\Build-Installer.ps1 sets this: no MSIX, and the runtime ships beside the exe so setup needs nothing else. -->
  <PropertyGroup Condition="'$(InstallerBuild)'=='true'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);SELF_CONTAINED_RUNTIME</DefineConstants>
    <ApplicationIcon>Assets\EasyTerminal.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <!-- System logos (Simple Icons, CC0) and flags (flag-icons, MIT) shown on device cards. -->
    <Content Include="Assets\Os\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Flags\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <!-- Native AI agent: Microsoft.Extensions.AI handles tool calling and streaming; providers plug in as IChatClient. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageReference Include="Anthropic" Version="13.4.0" />
    <ProjectReference Include="..\EasyTerminal.Core\EasyTerminal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Built-in Tailscale: EasyTerminal.Tailscale is a small Go program on tsnet, built here for the target
    platform and shipped beside the exe. Needs Go on PATH, or a portable copy in <repo>\.tools\go, or
    -p:GoExe=path. Without Go the app still builds; the Tailscale settings then say the helper is missing.
  -->
  <PropertyGroup>
    <TailscaleHelperDir>$(MSBuildThisFileDirectory)..\EasyTerminal.Tailscale\</TailscaleHelperDir>
    <TailscaleGoArch Condition="'$(Platform)'=='x86'">386</TailscaleGoArch>
    <TailscaleGoArch Condition="'$(Platform)'=='ARM64'">arm64</TailscaleGoArch>
    <TailscaleGoArch Condition="'$(TailscaleGoArch)'==''">amd64</TailscaleGoArch>
    <TailscaleHelperExe>$(TailscaleHelperDir)bin\$(TailscaleGoArch)\easyterminal-tailscale.exe</TailscaleHelperExe>
    <GoExe Condition="'$(GoExe)'=='' and Exists('$(MSBuildThisFileDirectory)..\..\..\.tools\go\bin\go.exe')">$(MSBuildThisFileDirectory)..\..\..\.tools\go\bin\go.exe</GoExe>
    <GoExe Condition="'$(GoExe)'==''">go</GoExe>
  </PropertyGroup>

  <Target Name="BuildTailscaleHelper" BeforeTargets="AssignTargetPaths"
          Inputs="$(TailscaleHelperDir)main.go;$(TailscaleHelperDir)go.mod;$(TailscaleHelperDir)go.sum" Outputs="$(TailscaleHelperExe)">
    <Exec Command="&quot;$(GoExe)&quot; version" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_GoExitCode" />
    </Exec>
    <Warning Condition="'$(_GoExitCode)'!='0'" Text="没有找到 Go，跳过内置 Tailscale 组件。安装 Go 或传入 -p:GoExe=... 以包含它。" />
    <Exec Condition="'$(_GoExitCode)'=='0'" WorkingDirectory="$(TailscaleHelperDir)"
          EnvironmentVariables="CGO_ENABLED=0;GOOS=windows;GOARCH=$(TailscaleGoArch)"
          Command="&quot;$(GoExe)&quot; build -trimpath -buildvcs=false -ldflags=&quot;-s -w -H windowsgui&quot; -o &quot;$(TailscaleHelperExe)&quot; ." />
  </Target>

  <Target Name="IncludeTailscaleHelper" AfterTargets="BuildTailscaleHelper" BeforeTargets="AssignTargetPaths">
    <ItemGroup Condition="Exists('$(TailscaleHelperExe)')">
      <Content Include="$(TailscaleHelperExe)" Link="easyterminal-tailscale.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix"/>
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Reflection-based JSON settings and WinRT projections are not trim-safe. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>

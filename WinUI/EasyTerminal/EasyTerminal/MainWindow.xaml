<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EasyTerminal.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:EasyTerminal.Services"
    xmlns:controls="using:EasyTerminal.Controls"
    Title="EasyTerminal">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control,Shift" Key="P" Invoked="OnPaletteAccelerator" />
        </Grid.KeyboardAccelerators>

        <TitleBar x:Name="AppTitleBar" Title="EasyTerminal">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE756;" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                <AutoSuggestBox
                    x:Name="Palette"
                    Width="560"
                    Margin="0,6"
                    VerticalAlignment="Center"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    PlaceholderText="搜索会话、连接和命令（Ctrl+Shift+P）"
                    QueryIcon="Find"
                    UpdateTextOnSelect="False"
                    GotFocus="OnPaletteGotFocus"
                    LostFocus="OnPaletteLostFocus"
                    PreviewKeyDown="OnPalettePreviewKeyDown"
                    TextChanged="OnPaletteTextChanged"
                    QuerySubmitted="OnPaletteSubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="services:PaletteItem">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind HasDetail}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Category}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <ToggleButton
                    x:Name="SnippetsButton"
                    ToolTipService.ToolTip="代码片段"
                    AutomationProperties.Name="代码片段"
                    VerticalAlignment="Center"
                    Padding="8,6"
                    BorderThickness="0"
                    Click="OnSnippetsButtonClick">
                    <FontIcon Glyph="&#xE943;" FontSize="16" />
                </ToggleButton>
                <ToggleButton
                    x:Name="AssistantButton"
                    ToolTipService.ToolTip="AI 助手"
                    AutomationProperties.Name="AI 助手"
                    VerticalAlignment="Center"
                    Padding="8,6"
                    BorderThickness="0"
                    Click="OnAssistantButtonClick">
                    <FontIcon Glyph="&#xE99A;" FontSize="16" />
                </ToggleButton>
                </StackPanel>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="280"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="640"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="OnNavItemInvoked"
            Expanding="OnNavExpanding"
            Collapsed="OnNavCollapsed">

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="密钥" Tag="keys">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <InfoBar
                    x:Name="Notice"
                    IsOpen="False"
                    Severity="Informational"
                    Margin="8,8,8,0" />

                <Grid x:Name="PageHost" Grid.Row="1" />
                <Grid x:Name="SessionHost" Grid.Row="1" ColumnSpacing="2" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0" />
                    </Grid.ColumnDefinitions>
                </Grid>

                <!-- Side panels. Pinned: column 1, beside the sessions. Floating: over the sessions, which keep their size. -->
                <Grid x:Name="SideHost" Grid.RowSpan="2" Grid.Column="1" Visibility="Collapsed" />
            </Grid>
        </NavigationView>

        <!-- Lies over the edge between the expanded pane and the content; MainWindow keeps it in place. -->
        <controls:ResizeHandle
            x:Name="SidebarHandle"
            Grid.Row="1"
            HorizontalAlignment="Left"
            Visibility="Collapsed" />
    </Grid>
</Window>
